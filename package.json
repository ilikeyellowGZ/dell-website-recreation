{
  "name": "gauvis-tech-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "db:setup": "tsx server/setupDatabase.ts",
    "preview": "tsx server/index.ts --port 4173",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "doctor": "react-doctor src --no-score --blocking warning"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "compression": "1.8.2",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "gsap": "3.15.0",
    "helmet": "8.1.0",
    "mongodb": "7.0.0",
    "motion": "13.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "9.2.5",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "react-doctor": "0.9.14",
    "react-grab": "0.2.0",
    "react-scan": "0.5.7",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Cache only existing build assets, never an SPA fallback for a missing asset.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^assets/ - [E=IMMUTABLE_ASSET:1]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [END]
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Security-Policy "default-src 'self'; connect-src 'self' https://guavis.onrender.com; font-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

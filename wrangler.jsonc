{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dell-website-recreation",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "main": "./worker/index.ts",
  "upload_source_maps": true,
  "vars": {
    "COMPANY_NOTIFICATION_EMAIL": "info@gauvistech.com",
    "ADMIN_LOGIN_NOTIFICATION_COOLDOWN_SECONDS": "900",
    "ENABLE_ENQUIRIES": "true",
    "MONGODB_COLLECTION": "enquiries",
    "MONGODB_DB_NAME": "gauvistech",
    "RESEND_FROM_EMAIL": "notification@guavistech.com"
  },
  "secrets": {
    "required": [
      "ADMIN_PASSWORD_HASH",
      "ADMIN_USERNAME",
      "JWT_SECRET_KEY",
      "MONGODB_URI",
      "RATE_LIMIT_KEY_SECRET",
      "RESEND_API_KEY"
    ]
  },
  "rules": [
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": false }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MONGODB_REPOSITORY", "class_name": "MongoEnquiryDurableObject" },
      { "name": "SECURITY_STATE", "class_name": "SecurityDurableObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MongoEnquiryDurableObject", "SecurityDurableObject"]
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}

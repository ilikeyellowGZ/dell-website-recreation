# Copy to .env for local development; never commit real values.
# See DEPLOYMENT.md before enabling production enquiries.

# Legacy Node/Render backend only. The Cloudflare Worker uses the names below as
# Worker secrets or variables; never use any of them with a VITE_ prefix.
# Local safe defaults follow.
NODE_ENV=development
# Leave empty locally so development preview serves the built frontend.
# Render overrides this with false to keep the production service API-only.
SERVE_FRONTEND=
TRUST_PROXY=
# Production: one or more comma-separated exact HTTPS origins, no paths/wildcards.
# Production website: https://gauvistech.com
# For Cloudflare preview testing, add its exact https://<worker>.<account>.workers.dev origin.
# Remove temporary preview origins when testing is finished.
# Leave empty locally to use same-origin requests through the Vite proxy.
FRONTEND_ORIGIN=
MONGODB_URI=
# URI example: mongodb+srv://<user>:<url-encoded-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=gauvistech
MONGODB_COLLECTION=enquiries
# All three are needed for team alerts and customer receipts; storage and login still work without email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notification@gauvistech.com
COMPANY_NOTIFICATION_EMAIL=info@gauvistech.com
# Legacy name only; prefer COMPANY_NOTIFICATION_EMAIL.
ADMIN_EMAIL=
# Optional backward-compatible fallback only. Prefer ADMIN_EMAIL for new deployments.
RESEND_TO_EMAIL=
# Optional. Defaults to 900 seconds (15 minutes) to avoid repeated successful-login alerts.
ADMIN_LOGIN_NOTIFICATION_COOLDOWN_SECONDS=900
# Generate locally with npm run admin:credentials; copy the hash privately to the API host.
# That command overwrites local admin credentials and resets both enquiry flags.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=
# Optional local API port; the API host provides its own PORT automatically.
# PORT=3001

# Leave the API URL empty for Cloudflare's same-origin /api (and the local Vite proxy).
# Use an explicit URL only for a legacy split-origin deployment.
VITE_API_BASE_URL=
# Never put backend secrets in the Cloudflare frontend build. Deploy only dist/ assets.

# Copy this file to .env for local development. Never commit the real values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=gauvistech
MONGODB_COLLECTION=enquiries

# Keep disabled until approved privacy and terms pages are published.
ENABLE_ENQUIRIES=false
VITE_ENABLE_ENQUIRIES=false

# Set to the number of trusted reverse-proxy hops. Leave blank for direct hosting.
TRUST_PROXY=

# Admin values are generated with `npm run admin:credentials`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=
